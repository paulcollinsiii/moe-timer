/* Copy to include/credentials.local.h and fill in real values.
 * credentials.local.h is gitignored (*.local.h) and must never be committed.
 * These seed NVS on first boot only (nvs_config_init_defaults writes them
 * when the keys are missing) — after changing them, run `idf.py erase-flash`
 * so the new values are picked up.
 */
#pragma once

#define NVS_DEFAULT_WIFI_SSID "your-ssid"
#define NVS_DEFAULT_WIFI_PASS "your-password"

/* MQTT broker for the Home Assistant integration. Empty/omitted disables
 * MQTT entirely. */
/* #define NVS_DEFAULT_MQTT_URI "mqtt://homeassistant.local:1883" */
/* #define NVS_DEFAULT_MQTT_USER "magtag" */
/* #define NVS_DEFAULT_MQTT_PASS "..." */

/* OTA manifest endpoint. Must be https:// — plain http is rejected, since
 * an unauthenticated firmware endpoint is an arbitrary-code-execution
 * channel. Omitted/empty disables update checks.
 *
 * Unlike the keys above, this one is NOT part of the defaults fingerprint
 * and is not reseeded: it is only the fallback used while NVS holds no
 * endpoint. Once Home Assistant sets one (the "OTA manifest URL" entity or
 * the bulk config document's ota_url), changing this has no effect on that
 * device — erase NVS to go back to the compile-time value. */
/* #define NVS_DEFAULT_OTA_URL "https://example.com/magtag/manifest.json" */
