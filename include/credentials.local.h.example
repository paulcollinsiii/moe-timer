/* Copy to include/credentials.local.h and fill in the real value.
 * credentials.local.h is gitignored (*.local.h) and must never be committed.
 *
 * WiFi and the MQTT broker are no longer set here: the device is
 * provisioned on-device (a SoftAP setup mode), and the owner enters both
 * there. This file now carries only the OTA manifest URL fallback.
 */
#pragma once

/* OTA manifest endpoint. Must be https:// — plain http is rejected, since
 * an unauthenticated firmware endpoint is an arbitrary-code-execution
 * channel. Omitted/empty disables update checks.
 *
 * This key is NOT part of the defaults fingerprint and is not reseeded: it
 * is only the fallback used while NVS holds no endpoint of its own. Once
 * Home Assistant sets one (the "OTA manifest URL" entity or the bulk
 * config document's ota_url), changing this has no effect on that device —
 * to change the OTA URL on a provisioned device, set it from Home
 * Assistant. */
/* #define NVS_DEFAULT_OTA_URL "https://example.com/magtag/manifest.json" */
