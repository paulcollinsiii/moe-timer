{
  "name": "MagTag Screen Timer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "runArgs": [
    "--privileged"
  ],
  "mounts": [
    "source=/dev/bus/usb,target=/dev/bus/usb,type=bind",
    "source=claude-code-config,target=/home/vscode/.claude,type=volume",
    "source=platformio-packages,target=/workspaces/.pio,type=volume"
  ],
  "remoteUser": "vscode",
  "containerEnv": {
    "PLATFORMIO_CORE_DIR": "/workspaces/.pio",
    "CLAUDE_CODE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "platformio.platformio-ide",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-vscode.serial-monitor",
        "eamodio.gitlens",
        "Anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "C_Cpp.default.compilerPath": "/usr/bin/gcc",
        "git.openRepositoryInParentFolders": "always"
      }
    }
  }
}