.vscode/
.worktrees/
sdkconfig
sdkconfig.old
sdkconfig.bak
build/
managed_components/
test/build/
test/build-fonts-*/
build-fonts-*/

# Bytecode from tools/check_slot_size.py, imported by its host test suite
__pycache__/

# Local secrets (WiFi credentials etc.) — never committed
*.local.h

# Private lock-screen art: <slot>.png files here replace the public
# templates in tools/sprites/ at build time (see docs/developer_setup.md)
sprites.local/

# The owner's device list for tools/gen_ha_dashboard.py (see
# tools/ha_devices.example.yaml)
tools/ha_devices.yaml

# Differential-sweep build artifacts (generators are the source of truth)
test/difftest/cycles/harness_*.c
